# Kopyala ve doldur:  cp deploy/.env.example deploy/.env
# deploy/.env GITIGNORE'DADIR — token, telefon numarasi, SIM PIN asla commit edilmez (PLAN.md GK9).

# --- Veritabani ---
DB_PASSWORD=gridup

# --- Broker ---
MQTT_HOST=mosquitto
MQTT_PORT=1883

# --- Sozlesmeler (konteyner icinde salt okunur baglanir) ---
CONTRACTS_DIR=/contracts

# --- Simulasyon (Kisi A) ---
SIM_PANELS=3
SIM_PERIOD_S=10
SIM_SPEED=60

# --- WhatsApp Cloud API (IKINCIL kanal, yalnizca hassas olmayan kisa alarm metni) ---
# On-Premises API 23 Ekim 2025'te kapatildi; yalnizca Cloud API var.
# Meta test numarasi dogrulama olmadan en fazla 5 aliciya gonderir — demo icin yeterli.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
ALERT_RECIPIENTS=

# --- SMS (BIRINCIL kanal; tam on-prem) ---
# Donanim alinmadigi icin sanal GSM modem kullanilir: scripts/virtual_gsm_modem.py
# Gercek modem takildiginda YALNIZCA bu yol degisir, surucu kodu aynidir.
SMS_DEVICE=/dev/ttyV0
SMS_BAUD=115200
SMS_SENDER=GRIDUP

# --- SCADA ag gecidi ---
MODBUS_TCP_PORT=502
MODBUS_WRITE_PASSWORD=
IEC104_PORT=2404
