# Kopyala ve doldur:  cp deploy/.env.example deploy/.env
# deploy/.env GITIGNORE'DADIR — token, telefon numarasi, SIM PIN asla commit edilmez (PLAN.md GK9).

# --- Veritabani ---
DB_PASSWORD=gridup

# --- Broker ---
MQTT_HOST=mosquitto
MQTT_PORT=1883

# --- Sozlesmeler (konteyner icinde salt okunur baglanir) ---
CONTRACTS_DIR=/contracts

# --- Simulasyon (Kisi A) ---
SIM_PANELS=3
SIM_PERIOD_S=10
SIM_SPEED=60

# --- Bildirim (TB2) — alici listeleri virgulle ---
# Demo degerleri HAYALIDIR ve yalnizca sanal modeme gider (deploy/runtime/sms-log.txt).
# Gercek numara yalnizca deploy/.env'e yazilir; .env git disidir.
ALERT_RECIPIENTS=+905550000001,+905550000002
ALERT_ESCALATION=+905550000009
PORTAL_URL=http://gridup.local
# P1 eskalasyonunda aramanin caldirma suresi (sn)
CALL_RING_S=20

# --- SMS (BIRINCIL kanal; tam on-prem) ---
# Donanim alinmadigi icin sanal GSM modem: scripts/virtual_gsm_modem.py (compose: gsm-modem)
# Gercek modem takildiginda YALNIZCA bu satir degisir, surucu kodu aynidir:
#   SMS_DEVICE=/dev/ttyUSB2                   (USB modem; compose'da devices: ile baglanir)
#   SMS_DEVICE=socket://ser2net-host:7000     (veri merkezinde terminal sunucusu)
SMS_DEVICE=socket://gsm-modem:7000
SMS_BAUD=115200

# --- WhatsApp Cloud API (IKINCIL kanal, yalnizca hassas olmayan kisa alarm metni) ---
# On-Premises API 23 Ekim 2025'te kapatildi; yalnizca Cloud API var. Bos birakilirsa kanal kapalidir.
# Meta kurali: serbest metin yalnizca alici son 24 saatte isletme numarasina yazdiysa teslim edilir;
# pencere disinda onayli sablon gerekir (WHATSAPP_TEMPLATE, govde parametreleri: oncelik, pano, metin).
# Meta test numarasi en fazla 5 dogrulanmis aliciya gonderir — demo icin yeterli.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_RECIPIENTS=
WHATSAPP_TEMPLATE=
WHATSAPP_API_VERSION=v25.0

# --- SCADA ag gecidi (Modbus TCP) — harita: docs/03-modbus-haritasi.md ---
# Makinede yayinlanan port (konteyner icinde hep 502). QModMaster: localhost:502, birim 1.
MODBUS_TCP_PORT=502
# Bos = SALT OKUNUR (onerilen varsayilan). 1-65535; komut blogu 900-909 yalnizca bununla yazilir.
# TVOC-2 aynasina (500-519) yazma sifre olsa da REDDEDILIR (PLAN.md GK6). 3 yanlis sifre = 5 dk kilit.
MODBUS_WRITE_PASSWORD=
# Birim -> pano. Bos = otomatik (pano kimligi sirasi; YALNIZCA demo). Sahada zorunlu:
#   MODBUS_UNITS=1=ADM-00001,2=ADM-00002
MODBUS_UNITS=
# Izinli istemci aglari (virgulle). Bos = 127/8, 10/8, 172.16/12, 192.168/16.
# Sahada SCADA on-uc sunucusuna daraltin, or.: MODBUS_ALLOWED_CLIENTS=10.20.30.40/32
MODBUS_ALLOWED_CLIENTS=
IEC104_PORT=2404
