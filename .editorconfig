# Bicim savaslarini onler: ucumuz ayni bosluk/satir sonu kurallarini kullanir.
# PLAN.md Bolum B, kural 1.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{c,h}]
indent_size = 4

[*.{yaml,yml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
